# Contoh konfigurasi model. Tidak ada nilai rahasia di sini.
# Salin file ini menjadi .env di root proyek, lalu isi DEEPSEEK_API_KEY.
# Aplikasi memuat .env otomatis saat start; export shell tetap lebih prioritas.

# Runtime agent: hermes (Hermes Agent resmi) | internal (rollback lama)
AGENT_RUNTIME=hermes

# Provider model untuk rollback internal: deepseek | ollama
MODEL_PROVIDER=deepseek

# --- TokenHarbor (OpenAI-compatible, model DeepSeek) ---
DEEPSEEK_BASE_URL=https://tokenharbor.ai/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash:free
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_RETRY=1
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_MAX_TOKENS_TOOL=256

# --- Hermes Agent API Server (runtime utama) ---
# HERMES_API_KEY adalah kredensial gateway Hermes lokal, berbeda dengan
# DEEPSEEK_API_KEY yang dipakai Hermes untuk memanggil TokenHarbor.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_TIMEOUT=180
HERMES_POLL=0.3
HERMES_MAX_RETRY=2
# Cara menunggu akhir run: sse (default, 1 stream + 1 GET status) atau polling
# (jalur lama untuk rollback/A-B). Keduanya memakai batas HERMES_TIMEOUT.
HERMES_WAIT_MODE=sse

# Opsional: lokasi source Hermes dan data root gateway. Kosongkan untuk default.
# HERMES_SOURCE=
# HERMES_HOME=
# HERMES_LOG_DIR=

# --- Ollama lokal (rollback hanya) ---
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=hermes3:8b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_PREDICT=384
OLLAMA_NUM_PREDICT_TOOL=192
OLLAMA_KEEP_ALIVE=10m
